    "@radix-ui/react-select": "^2.3.6",
    "@radix-ui/react-slot": "^1.3.2",
    "@radix-ui/react-toggle": "^1.1.17",
    "@radix-ui/react-toggle-group": "^1.1.18",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "ai": "^7.0.37",
    "class-variance-authority": "^0.7.1",
