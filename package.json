{
  "name": "rewritepal-official",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
